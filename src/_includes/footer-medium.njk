<footer class="site-footer"><div class="footer-inner footer-inner--compact">
  <section class="footer-group footer-group--org" aria-label="Verantwortung">
    <div class="footer-group-title">Fachstelle &amp; Verantwortung</div>
    <p class="footer-credit">Ein Informationsangebot der Fachstelle Angehörigenarbeit der Psychiatrischen Universitätsklinik Zürich (PUK).</p>
    <p class="footer-attribution">{% if footerAttribution %}{{ footerAttribution }}{% else %}Inhaltliche Verantwortung: Ch. Egger · Inhaltlich geprüft: {{ site.contentReviewedDisplay }}{% endif %}</p>
    <p class="footer-status"><strong>Aktualisierungsstand:</strong> Inhalt {{ site.contentReviewedDisplay }} · Technik {{ build.stand }}</p>
  </section>

  <section class="footer-group footer-group--links" aria-label="Rechtliches und Quellen">
    <div class="footer-group-title">Rechtliches, Quellen &amp; Barrierefreiheit</div>
    <div class="footer-links">
      <a href="/impressum/#impressum">Impressum</a>
      <a href="/impressum/#datenschutz">Datenschutz</a>
      <a href="mailto:{{ site.email }}">Datenschutzkontakt</a>
      <a href="/barrierefreiheit/">Barrierefreiheit</a>
      <a href="{{ site.sourcesPage }}">Quellen</a>
    </div>
  </section>

  <section class="footer-group footer-group--emergency" aria-label="Notfall und Krisenhilfe">
    <div class="footer-group-title">Notfall &amp; Krisenhilfe</div>
    <p class="footer-disclaimer">Die Inhalte dienen der psychoedukativen Orientierung — sie ersetzen keine Diagnostik, Behandlung, Notfallintervention oder persönliche Beratung.</p>
    <p class="footer-emergency-note">In akuten Lagen hat der <a href="/notfall/" class="footer-link-alert">Notfallweg</a> Vorrang.</p>
  </section>
</div>
<div class="footer-bottom-bar">
  <p class="footer-copyright">© {{ site.buildYear | default("2025") }} Psychiatrische Universitätsklinik Zürich · Fachstelle Angehörigenarbeit</p>
</div></footer>
