{
  "name": "bipolarsite",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "npm run clean && eleventy && npx pagefind --site _site",
    "serve": "eleventy --serve",
    "clean": "rm -rf _site",
    "lint:html": "html-validate \"_site/**/*.html\"",
    "lint:css": "stylelint \"src/**/*.css\" \"src/fonts/*.css\"",
    "lint:lighthouse": "CONTEXT=production npm run build && CONTEXT=production npx @lhci/cli@0.14.0 autorun --config=lighthouserc.json",
    "lint:a11y": "node scripts/run-a11y-check.mjs",
    "lint": "npm run lint:html && npm run lint:css",
    "test:e2e": "npm run test:e2e:preflight && playwright test",
    "test:e2e:ui": "playwright test --ui",
    "audit:release": "node scripts/release-audit/index.mjs",
    "audit:release:ci": "node scripts/release-audit/index.mjs --skip-production --json",
    "audit:release:prod": "node scripts/release-audit/index.mjs --production-only",
    "audit:release:json": "node scripts/release-audit/index.mjs --json",
    "check:acute-pdfs": "node scripts/check-acute-pdfs.mjs",
    "handout:starter": "python3 scripts/fachstelle-handout/render_measure_verify.py docs/fachstelle-handout-workflow/fachstelle-handout-starter.html --type orientierung --orientation landscape --allow-template-placeholders",
    "handout:render": "python3 scripts/fachstelle-handout/render_measure_verify.py",
    "handout:verify": "python3 scripts/fachstelle-handout/verify_fachstelle_handout.py",
    "test:e2e:preflight": "node scripts/check-playwright-browsers.mjs",
    "test:release-audit": "node --test \"scripts/release-audit/**/*.test.mjs\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-img": "^4.0.2",
    "@axe-core/cli": "^4.11.3",
    "@playwright/test": "^1.59.1",
    "html-validate": "^9.0.0",
    "http-server": "^14.1.1",
    "pa11y-ci": "^4.1.0",
    "pagefind": "^1.5.2",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0",
    "wait-on": "^9.0.5"
  },
  "overrides": {
    "axios": "^1.16.0",
    "liquidjs": "^10.25.7",
    "lodash": "^4.18.1",
    "markdown-it": "^14.1.1"
  }
}
